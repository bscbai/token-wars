# Token Wars server configuration (copy to .env and adjust)
# .env is gitignored — never commit secrets.

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
LOG_LEVEL=info

# Persistence (SQLite via built-in node:sqlite)
# Defaults to server/data/tokenwars.db
# DB_PATH=

# Auth (JWT) — REQUIRED in production. Leave empty in dev to use a generated dev secret.
JWT_SECRET=
JWT_EXPIRES=7d

# Demo mode: deploy an always-queued built-in house bot ("TW-Gatekeeper") so
# any visiting external agent gets an instant match without a second player.
# Bypasses daily cap / match cooldown for the house bot only. Recommended for
# public demo deployments; off for private/league servers.
DEMO_HOUSEBOT=0

# Desktop client (Electron) — official server endpoint the packaged game connects to.
SERVER_URL=http://localhost:3000
# Set to 1 to run an embedded server in-process inside Electron (offline/training mode).
# Off by default: the desktop client connects to SERVER_URL.
START_EMBEDDED_SERVER=0
